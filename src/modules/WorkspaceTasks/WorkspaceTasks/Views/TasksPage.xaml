<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WorkspaceTasks.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WorkspaceTasks.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WorkspaceTasks.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />

        <Style x:Key="StretchedListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="TaskItemTemplate" x:DataType="vm:WorkTaskViewModel">
            <Grid Padding="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    Grid.Column="0"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    IsChecked="{x:Bind IsDone, Mode=TwoWay}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis" />

                <!--  Per-task workspace picker: link an existing workspace after the fact  -->
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="OpenWorkspacePicker_Click"
                    ToolTipService.ToolTip="Link or change the workspace for this task">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE71B;" />
                        <TextBlock FontSize="12" Text="{x:Bind WorkspaceLabel, Mode=OneWay}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Width="260" Spacing="8">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Link a workspace" />
                                <ListView
                                    MaxHeight="260"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding Workspaces}"
                                    SelectionChanged="WorkspacePicker_SelectionChanged"
                                    SelectionMode="Single" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="UnlinkWorkspace_Click"
                                    Content="Unlink workspace" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Command="{Binding DataContext.LaunchWorkspaceCommand, ElementName=RootPanel}"
                    CommandParameter="{Binding}"
                    ToolTipService.ToolTip="Launch linked workspace"
                    Visibility="{x:Bind HasWorkspace, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE7AC;" />
                </Button>

                <Button
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Command="{Binding DataContext.LaunchWorkspaceInNewDesktopCommand, ElementName=RootPanel}"
                    CommandParameter="{Binding}"
                    ToolTipService.ToolTip="Launch in a new virtual desktop"
                    Visibility="{x:Bind HasWorkspace, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE7C4;" />
                </Button>

                <Button
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Command="{Binding DataContext.DeleteTaskCommand, ElementName=RootPanel}"
                    CommandParameter="{Binding}"
                    ToolTipService.ToolTip="Delete task">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootPanel" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Compact add-task row  -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="NewTaskBox"
                Grid.Column="0"
                VerticalAlignment="Center"
                KeyDown="NewTaskBox_KeyDown"
                PlaceholderText="Add a task and press Enter…"
                Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                Grid.Column="1"
                MinWidth="150"
                VerticalAlignment="Center"
                DisplayMemberPath="DisplayName"
                DropDownOpened="WorkspaceCombo_DropDownOpened"
                ItemsSource="{x:Bind ViewModel.Workspaces}"
                PlaceholderText="Link… (optional)"
                SelectedItem="{x:Bind ViewModel.SelectedWorkspace, Mode=TwoWay}"
                ToolTipService.ToolTip="Optionally link a workspace to the new task"
                Visibility="{x:Bind ViewModel.WorkspacesAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.AddTaskCommand}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Add task">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>

            <!--  Global capture: save the current window layout as a new workspace  -->
            <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Capture current windows as a new workspace"
                Visibility="{x:Bind ViewModel.WorkspacesAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE722;" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="280" Spacing="8">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Capture a new workspace" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Saves your current window layout as a new PowerToys workspace you can link to any task."
                                TextWrapping="Wrap" />
                            <TextBox
                                PlaceholderText="New workspace name"
                                Text="{x:Bind ViewModel.NewWorkspaceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.CaptureWorkspaceCommand}"
                                Content="Capture &amp; save"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  Task lists  -->
        <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Spacing="8">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Active" />
                <ListView
                    ItemContainerStyle="{StaticResource StretchedListViewItemStyle}"
                    ItemTemplate="{StaticResource TaskItemTemplate}"
                    ItemsSource="{x:Bind ViewModel.ActiveTasks}"
                    SelectionMode="None" />

                <Expander
                    Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"
                    Header="Completed">
                    <ListView
                        ItemContainerStyle="{StaticResource StretchedListViewItemStyle}"
                        ItemTemplate="{StaticResource TaskItemTemplate}"
                        ItemsSource="{x:Bind ViewModel.CompletedTasks}"
                        SelectionMode="None" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!--  Status bar  -->
        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing
                Grid.Column="0"
                Width="18"
                Height="18"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.StatusMessage, Converter={StaticResource EmptyStringToVisibility}, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
